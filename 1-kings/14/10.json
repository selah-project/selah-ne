{"tier":"glm-5.2","verse":10,"ref":"1-kings 14:10","book":"1-kings","lang":"ne","chapter":14,"translation":"त्यसैले हेर, म यारोभामको घरमाथि विपत्ति ल्याउँदैछु, र यारोभामका घरबाट भित्तामा पिसाब फाल्ने हरेकलाई — बन्द गरिएको र छाडिएको, इस्राएलमा — काटिदिनेछु; र यारोभामको घरको पछि लागेर मासिदिनेछु, जसरी गुराँस मासिन्छ, समाप्त नहुँदासम्म।","tokens":[{"surface":"לכן","gloss":"त्यसैले"},{"surface":"הנני","gloss":"हेर, म"},{"surface":"מביא","gloss":"ल्याउँदैछु"},{"surface":"רעה","gloss":"विपत्ति"},{"surface":"אל","gloss":"माथि"},{"surface":"בית","gloss":"घर"},{"surface":"ירבעם","gloss":"यारोभामको"},{"surface":"והכרתי","gloss":"र काटिदिनेछु"},{"surface":"לירבעם","gloss":"यारोभामका लागि"},{"surface":"משתין","gloss":"पिसाब फाल्ने"},{"surface":"בקיר","gloss":"भित्तामा"},{"surface":"עצור","gloss":"बन्द गरिएको"},{"surface":"ועזוב","gloss":"र छाडिएको"},{"surface":"בישראל","gloss":"इस्राएलमा"},{"surface":"ובערתי","gloss":"र मासिदिनेछु"},{"surface":"אחרי","gloss":"पछि लागेर"},{"surface":"בית","gloss":"घरको"},{"surface":"ירבעם","gloss":"यारोभाम"},{"surface":"כאשר","gloss":"जसरी"},{"surface":"יבער","gloss":"मासिन्छ"},{"surface":"הגלל","gloss":"गुराँस"},{"surface":"עד","gloss":"सम्म"},{"surface":"תמו","gloss":"समाप्त नहुँदा"}],"timestamp":"2026-08-26T22:04:26.593838091Z","model":"glm-5.3"}